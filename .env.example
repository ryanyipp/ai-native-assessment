# Copy to .env and fill in locally. Never commit .env.

# OpenRouter (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Candidates: google/gemini-3-flash-preview (default), anthropic/claude-haiku-4.5
OPENROUTER_MODEL=google/gemini-3-flash-preview

# Model budget (tunable starting points from docs/plan.md)
FLOWLENS_MAX_CONCURRENT_MODEL_CALLS=2
FLOWLENS_MAX_MODEL_CALLS_PER_RUN=40
FLOWLENS_BUDGET_USD=10

# Application
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
FIXTURE_PORT=5174
DATABASE_URL=sqlite:///./artifacts/flowlens.db
ARTIFACTS_DIR=./artifacts

# Allowed target origins (comma-separated; authorised local/staging only)
FLOWLENS_ALLOWED_ORIGINS=http://localhost:5174

# Optional supplied test session (path to a Playwright storage state kept outside Git)
FLOWLENS_TEST_SESSION_PATH=
